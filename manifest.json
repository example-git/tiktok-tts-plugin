{
  "schema": 1,
  "id": "tiktok-tts",
  "name": "TikTok TTS",
  "description": "Generate speech using TikTok voices.",
  "category": "tts",
  "runtime": "stdio-v1",
  "entrypoint": "extension",
  "fields": [
    {
      "key": "endpoint",
      "label": "API region",
      "type": "select",
      "required": true,
      "default": "https://api16-normal-useast5.us.tiktokv.com",
      "options": [
        {
          "value": "https://api16-normal-useast5.us.tiktokv.com",
          "label": "US East 5"
        },
        {
          "value": "https://api16-normal-useast5.tiktokv.us",
          "label": "US East 5 alternate"
        }
      ]
    },
    {
      "key": "session_token",
      "label": "TikTok session token",
      "type": "password",
      "required": true,
      "max_length": 32,
      "pattern": "^[a-fA-F0-9]{32}$",
      "help": "TikTok sessionid. Leave blank to keep the saved credential."
    }
  ],
